# Free option (default): get a key at https://aistudio.google.com/apikey (no credit card)
VISION_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-key
# If a model name is retired, pick another Flash / Flash-Lite model listed in AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite

# Paid option: set VISION_PROVIDER=anthropic and fill these in
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

MAX_UPLOAD_MB=8
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
